# docker-compose.yml / docker-compose.prod.yml の mysql サービスが env_file で読む設定のテンプレート。
# db/.env にコピーして値を埋める（ローカルでも本番サーバーでも必要）。
# このファイル自体はテンプレートなので実際の値を書かないこと（.env は gitignore 済み）。
#
# MYSQL_* は MySQL コンテナがボリュームを初めて作るときにだけ使われる。
# 作成後に値を変えても既存の DB には反映されない。

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=myapp
# アプリ用ユーザー。nextjs/.env の DB_USER / DB_PASSWORD と揃える
MYSQL_USER=appuser
MYSQL_PASSWORD=
